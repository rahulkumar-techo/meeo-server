  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/apps/worker/main.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/apps/worker/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "ci:verify": "npm run prisma:generate && npm run typecheck && npm test -- --run && npm run build",
    "prepare": "husky",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma skills sync || exit 0"
  }
