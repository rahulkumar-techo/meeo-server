// Represents the main product information shared by all of its variants.
model Product {
  id String @id @default(uuid()) @db.Uuid

  categoryId  String? @db.Uuid
  brandId     String? @db.Uuid
  createdById String? @db.Uuid

  name String
  slug String @unique

  description String?

  status ProductStatus @default(DRAFT)

  isFeatured Boolean @default(false)

  seoTitle       String?
  seoDescription String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand    Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  creator  User?     @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  bannerImage    Json?
  specifications Json?

  images   Image[] @relation("ProductImages")
  variants ProductVariant[]

  reviews Review[]

  wishlistItems WishlistItem[]

  @@index([categoryId])
  @@index([brandId])
  @@index([createdById])
  @@index([status])
  @@index([isFeatured])
  @@index([status, isFeatured, createdAt])
  @@index([status, createdAt])
  @@index([categoryId, status])
  @@index([brandId, status])
  @@map("products")
}

// Unified image storage for Products, Product Variants, and Reviews with ImageKit metadata.
model Image {
  id               String          @id @default(uuid()) @db.Uuid

  fileId           String?
  url              String
  thumbnailUrl     String?
  altText          String?
  sortOrder        Int             @default(0)
  width            Int?
  height           Int?
  size             Int?

  productId        String?         @db.Uuid
  productVariantId String?         @db.Uuid
  reviewId         String?         @db.Uuid

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  product          Product?        @relation("ProductImages", fields: [productId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant? @relation("VariantImages", fields: [productVariantId], references: [id], onDelete: Cascade)
  review           Review?         @relation("ReviewImages", fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productVariantId])
  @@index([reviewId])
  @@map("images")
}

