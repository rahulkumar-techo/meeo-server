// Represents a product brand or manufacturer.
model Brand {
  id String @id @default(uuid()) @db.Uuid

  name String
  slug String @unique

  logoUrl     String?
  description String?

  status ProductStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("brands")
}
