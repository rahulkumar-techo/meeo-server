// Represents a product brand or manufacturer.
model Brand {
  id String @id @default(uuid()) @db.Uuid

  createdById String? @db.Uuid

  name String
  slug String @unique

  logoUrl     String?
  description String?

  status ProductStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator User? @relation("BrandCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  products Product[]

  @@index([createdById])
  @@map("brands")
}
