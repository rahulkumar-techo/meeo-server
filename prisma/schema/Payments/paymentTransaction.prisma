// Stores individual financial operations such as charges, captures, refunds, and reversals.
model PaymentTransaction {
  id String @id @default(uuid()) @db.Uuid

  paymentId String @db.Uuid

  paymentAttemptId String? @db.Uuid

  type PaymentTransactionType

  status TransactionStatus

  amount Decimal @db.Decimal(12, 2)

  currency String @db.Char(3)

  providerTransactionId String?

  providerResponse Json?

  idempotencyKey String?

  failureCode    String?
  failureMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id])

  attempt PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id])

  @@index([paymentId])
  @@index([providerTransactionId])
  @@map("payment_transactions")
}
