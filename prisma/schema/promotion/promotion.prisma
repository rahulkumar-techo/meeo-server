// Represents an advanced promotional campaign or discount rule in MEEO.
model Promotion {
  id String @id @default(uuid()) @db.Uuid

  name        String
  slug        String  @unique
  description String?

  code String? @unique

  type   PromotionType
  status PromotionStatus @default(DRAFT)

  priority     Int                   @default(0)
  isStackable  Boolean               @default(false)
  stackingRule PromotionStackingRule @default(EXCLUSIVE)
  isAutomatic  Boolean               @default(false)

  customerSegment CustomerSegment @default(ALL)
  firstOrderOnly  Boolean         @default(false)

  discountValue     Decimal? @db.Decimal(12, 2)
  maxDiscountAmount Decimal? @db.Decimal(12, 2)
  minOrderSubtotal  Decimal? @db.Decimal(12, 2)
  minQuantity       Int?

  buyXQuantity           Int?
  getYQuantity           Int?
  getYDiscountPercentage Decimal? @db.Decimal(5, 2)

  startsAt       DateTime?
  endsAt         DateTime?
  timeOfDayStart String?
  timeOfDayEnd   String?
  daysOfWeek     Int[]     @default([])

  totalUsageLimit   Int?
  userUsageLimit    Int?
  currentUsageCount Int  @default(0)

  targetProductIds    String[] @default([])
  targetCategoryIds   String[] @default([])
  targetBrandIds      String[] @default([])
  excludedProductIds  String[] @default([])
  excludedCategoryIds String[] @default([])

  metadata Json?

  createdById String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator User?            @relation("PromotionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  usages  PromotionUsage[]

  @@index([status])
  @@index([type])
  @@index([priority])
  @@index([isAutomatic, status])
  @@index([startsAt, endsAt])
  @@index([code])
  @@map("promotions")
}

// Records each successful redemption/application of a promotion for an order.
model PromotionUsage {
  id String @id @default(uuid()) @db.Uuid

  promotionId String @db.Uuid
  orderId     String @db.Uuid
  userId      String? @db.Uuid

  discountAmount Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([promotionId])
  @@index([orderId])
  @@index([userId])
  @@index([promotionId, userId])
  @@map("promotion_usages")
}
